generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum PayPeriodStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
}

enum ChargeCategory {
  EARNED
  USED
  WORKED
  ADJUSTMENT
}

enum AccrualImpact {
  ADDS
  SUBTRACTS
  NEUTRAL
}

enum Cadence {
  WEEKLY
  BI_WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  users        User[]
  paySchedules PaySchedule[]
  chargeCodes  ChargeCode[]
  payPeriods   PayPeriod[]
  holidays     Holiday[]
  settings     OrgSetting[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model OrgSetting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  email          String
  role           UserRole
  payScheduleId  String?
  hireDate       DateTime
  organization   Organization  @relation(fields: [organizationId], references: [id])
  paySchedule    PaySchedule?  @relation(fields: [payScheduleId], references: [id])
  timeEntries    TimeEntry[]
  balances       PTOBalance[]
  settings       UserSetting[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, email])
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

model PaySchedule {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  cadence        Cadence
  anchorDate     DateTime
  users          User[]
  payPeriods     PayPeriod[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
}

model PayPeriod {
  id             String          @id @default(cuid())
  organizationId String
  payScheduleId  String
  startDate      DateTime
  endDate        DateTime
  status         PayPeriodStatus @default(DRAFT)
  timeEntries    TimeEntry[]
  organization   Organization    @relation(fields: [organizationId], references: [id])
  paySchedule    PaySchedule     @relation(fields: [payScheduleId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, payScheduleId, startDate, endDate])
}

model ChargeCode {
  id             String         @id @default(cuid())
  organizationId String
  codeKey        String
  displayName    String
  category       ChargeCategory
  isPaid         Boolean
  accrualImpact  AccrualImpact
  isActive       Boolean        @default(true)
  colorCode      String?
  type           String?
  timeEntries    TimeEntry[]
  balances       PTOBalance[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, codeKey])
}

model TimeEntry {
  id           String     @id @default(cuid())
  userId       String
  payPeriodId  String
  entryDate    DateTime
  chargeCodeId String
  hoursLogged  Float
  notes        String?
  user         User       @relation(fields: [userId], references: [id])
  payPeriod    PayPeriod  @relation(fields: [payPeriodId], references: [id])
  chargeCode   ChargeCode @relation(fields: [chargeCodeId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, entryDate])
  @@unique([userId, payPeriodId, entryDate, chargeCodeId])
}

model PTOBalance {
  id             String     @id @default(cuid())
  userId         String
  chargeCodeId   String
  earnedYtd      Float      @default(0)
  usedYtd        Float      @default(0)
  bankedHours    Float      @default(0)
  adjustments    Float      @default(0)
  currentBalance Float      @default(0)
  user           User       @relation(fields: [userId], references: [id])
  chargeCode     ChargeCode @relation(fields: [chargeCodeId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, chargeCodeId])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  date           DateTime
  isFloating     Boolean      @default(false)
  year           Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name, date])
}
